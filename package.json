{
  "name": "claude-code-session-finder",
  "displayName": "Claude Code Session Finder",
  "description": "Search the contents of your Claude Code sessions and jump straight to one.",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "local-placeholder",
  "repository": {
    "type": "git",
    "url": "https://github.com/shobhitg/claude-code-session-finder"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icon.png",
  "keywords": [
    "claude",
    "claude code",
    "search",
    "sessions",
    "history"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sessionFinder.search",
        "title": "Claude: Search Sessions"
      }
    ],
    "configuration": {
      "title": "Claude Code Session Finder",
      "properties": {
        "sessionFinder.defaultWindow": {
          "type": "string",
          "default": "7d",
          "description": "Default recency window for searches. e.g. 7d, 30d, all"
        }
      }
    },
    "keybindings": [
      {
        "command": "sessionFinder.search",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "pretest": "npm run check:fixtures",
    "test": "vitest run",
    "test:e2e": "tsc -p tsconfig.e2e.json && node out/test-e2e/runTest.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "check:fixtures": "node scripts/check-fixtures.mjs test/fixtures",
    "vscode:prepublish": "node esbuild.mjs --no-sourcemap",
    "package": "npx --no @vscode/vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
