{
  "name": "claude-code-session-finder",
  "displayName": "Claude Code Session Finder",
  "description": "Search the contents of your Claude Code sessions and jump straight to one.",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "shobhitg",
  "repository": {
    "type": "git",
    "url": "https://github.com/shobhitg/claude-code-session-finder"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icon.png",
  "keywords": [
    "claude",
    "claude code",
    "search",
    "sessions",
    "history"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sessionFinder.search",
        "title": "Claude: Search Sessions"
      },
      {
        "command": "sessionFinder.showSessions",
        "title": "Claude: Show Sessions"
      }
    ],
    "configuration": {
      "title": "Claude Code Session Finder",
      "properties": {
        "sessionFinder.defaultWindow": {
          "type": "string",
          "default": "60d",
          "description": "Default recency window for searches, e.g. 30d, 60d, all. Exact-identifier queries such as pr:123 ignore it entirely. Widen any search inline with since:all."
        },
        "sessionFinder.activeWindow": {
          "type": "string",
          "default": "4h",
          "pattern": "^\\s*\\d+\\s*[hdwm]?\\s*$",
          "description": "Sessions written within this window are ACTIVE and show a live state (running / needs you). Examples: 2h, 8h, 1d. Everything older is history."
        },
        "sessionFinder.toolQuietSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "A session that has been waiting on a tool call for longer than this is shown as \"waiting on a tool or a permission prompt\". Raise it if your tests or builds run long."
        },
        "sessionFinder.stalledMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "A session whose model has written nothing for this long is shown as stalled. Long answers are normal for several minutes, which is why the default is not lower."
        }
      }
    },
    "keybindings": [
      {
        "command": "sessionFinder.search",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "pretest": "npm run check:fixtures",
    "test": "vitest run",
    "test:e2e": "tsc -p tsconfig.e2e.json && node out/test-e2e/runTest.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "check:fixtures": "node scripts/check-fixtures.mjs test/fixtures",
    "vscode:prepublish": "node esbuild.mjs --no-sourcemap",
    "package": "npx --no @vscode/vsce package",
    "publish:ovsx": "ovsx publish -p $OVSX_TOKEN",
    "publish:vsce": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
